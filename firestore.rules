rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check endpoint for testing Firestore connectivity
    match /test/{testDoc} {
      allow read: if isValidId(testDoc);
    }

    // User profiles & private finance data
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      match /finance/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(docId);
      }
    }
  }
}
